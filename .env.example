# Base URL for the Go Platform API (Gateway, Auth, Assistants, Transcripts)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Base URL for the Python AI Service (Voice Playground, Webhooks, LLM Streaming)
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:3002

